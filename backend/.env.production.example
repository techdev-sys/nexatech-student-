APP_NAME="Nexatech School Operations Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN.example
FRONTEND_URL=https://YOUR_DOMAIN.example

LOG_CHANNEL=stack
LOG_STACK=stderr,slack
LOG_LEVEL=warning
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=mysql
DB_HOST=YOUR_MANAGED_DATABASE_HOST
DB_PORT=3306
DB_DATABASE=nexatech_production
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=GENERATE_A_UNIQUE_SECRET

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PASSWORD=GENERATE_A_UNIQUE_SECRET
REDIS_PORT=6379

AUTH_COOKIE_NAME=nexatech_session
AUTH_COOKIE_DOMAIN=YOUR_DOMAIN.example
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_LIFETIME_MINUTES=43200
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true

PUBLIC_REGISTRATION_ENABLED=false
DEMO_CODE_LIFETIME_MINUTES=1440
DEMO_SESSION_LIFETIME_MINUTES=120
DEMO_SCHOOL_EMAIL=demo@YOUR_DOMAIN.example
DEMO_REQUEST_NOTIFICATION_EMAIL=you@YOUR_DOMAIN.example

MAIL_MAILER=smtp
MAIL_HOST=YOUR_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=GENERATE_A_UNIQUE_SECRET
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=no-reply@YOUR_DOMAIN.example
MAIL_FROM_NAME="Nexatech School Operations Platform"

AT_USERNAME=YOUR_AFRICAS_TALKING_USERNAME
AT_API_KEY=GENERATE_A_UNIQUE_SECRET
AT_SANDBOX=false
AT_SENDER_ID=NEXATECH

PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_WEBHOOK_SECRET=

BACKUP_PROVIDER=YOUR_MANAGED_DATABASE_PROVIDER
BACKUP_RETENTION_DAYS=30
